&SURF ID='STEEL', COLOR='DIM GRAY' /
&SURF ID='WOOD', COLOR='SANDY BROWN' /

! IFC_SOURCE {"entity_key": "audit:circle", "source_id": "d19b94d25eadf49402e34b5a36ec7bf80bb2dc9c4df6a2ef7da7f86994737364", "global_id": "audit-circle", "step_id": 999, "ifc_type": "IfcDuctSegment"}
