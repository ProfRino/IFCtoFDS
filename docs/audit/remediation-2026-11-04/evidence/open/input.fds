&HEAD CHID='door_open' /
&MESH IJK=10,10,10, XB=0,1,0,1,0,1 /
&TIME T_END=2.0 /
&DUMP DT_DEVC=0.1, DT_CTRL=0.1 /

&DEVC ID='DEVC_DOOR_TIME', QUANTITY='TIME', SETPOINT=1.00 /
&CTRL ID='CTRL_DOOR', FUNCTION_TYPE='ANY', INPUT_ID='DEVC_DOOR_TIME' /
&OBST XB=0.4,0.6,0.2,0.8,0.2,0.8, SURF_ID='INERT', CTRL_ID='CTRL_DOOR' /

&TAIL /
